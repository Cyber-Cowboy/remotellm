# ---- Modal (active deployment path — see README.md "Modal deployment") ----
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_WORKER_IMAGE=docker.io/<DOCKERHUB_USERNAME>/gptoss-120b-worker:latest
MODAL_GPU_TYPES=A100-80GB,H100
MODAL_MAX_CONTAINERS=1
MODAL_SCALEDOWN_WINDOW_SECONDS=60
MODAL_STARTUP_TIMEOUT_SECONDS=1800
MODAL_VOLUME_NAME=gptoss-120b-model-cache

# ---- Runpod (alternative/legacy path — requires a prepaid account balance) ----
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_DATA_CENTER=US-KS-2
RUNPOD_GPU_TYPE_IDS="NVIDIA A100 80GB PCIe,NVIDIA H100 80GB PCIe,NVIDIA A100-SXM4-80GB"
RUNPOD_NETWORK_VOLUME_SIZE_GB=100

# ---- Docker registry ----
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
WORKER_IMAGE=docker.io/<DOCKERHUB_USERNAME>/gptoss-120b-worker:latest

# ---- Model ----
MODEL_REPO=HauhauCS/GPTOSS-120B-Uncensored-HauhauCS-Aggressive
MODEL_FILE=GPTOSS-120B-Uncensored-HauhauCS-Aggressive-MXFP4.gguf
MODEL_DIR=/runpod-volume/models/gpt-oss-120b-uncensored
SERVED_MODEL_NAME=gpt-oss-120b-uncensored
HF_TOKEN=

# ---- llama.cpp server tuning ----
MAX_MODEL_LEN=8192
N_GPU_LAYERS=999
N_CPU_MOE=0
MAX_CONCURRENT=2
LLAMA_SERVER_PORT=8080
LLAMA_INTERNAL_API_KEY=

# ---- Proxy (OpenAI-compatible gateway) ----
PROXY_API_KEY=
ALLOWED_ORIGINS=
UPSTREAM_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
LOG_PROMPTS=false
