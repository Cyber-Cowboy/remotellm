# ---- Runpod (see README "One-time bootstrap") ----
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_DATA_CENTER=US-CA-2
RUNPOD_GPU_TYPE_IDS="NVIDIA A100 80GB PCIe,NVIDIA H100 PCIe,NVIDIA A100-SXM4-80GB,NVIDIA H100 80GB HBM3"
RUNPOD_NETWORK_VOLUME_SIZE_GB=100

# ---- Docker registry ----
DOCKERHUB_USERNAME=
DOCKERHUB_TOKEN=
WORKER_IMAGE=docker.io/<DOCKERHUB_USERNAME>/gptoss-120b-worker:latest

# ---- Model ----
MODEL_REPO=HauhauCS/GPTOSS-120B-Uncensored-HauhauCS-Aggressive
MODEL_FILE=GPTOSS-120B-Uncensored-HauhauCS-Aggressive-MXFP4.gguf
MODEL_DIR=/runpod-volume/models/gpt-oss-120b-uncensored
SERVED_MODEL_NAME=gpt-oss-120b-uncensored
HF_TOKEN=

# ---- llama.cpp server tuning ----
MAX_MODEL_LEN=8192
N_GPU_LAYERS=999
N_CPU_MOE=0
MAX_CONCURRENT=2
LLAMA_SERVER_PORT=8080
LLAMA_INTERNAL_API_KEY=

# ---- Proxy / dashboard gateway (OpenAI-compatible) ----
PROXY_API_KEY=
ALLOWED_ORIGINS=
UPSTREAM_TIMEOUT_SECONDS=600
RATE_LIMIT_PER_MINUTE=60
LOG_PROMPTS=false

# ---- Dashboard (see README "The dashboard") ----
DASHBOARD_PORT=8787
MODEL_IDLE_TIMEOUT_SECONDS=60
